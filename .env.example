# ==============================================================================
# KONFIGURASI ENVIRONMENT PRODUCTION (VERCEL + NEON POSTGRESQL)
# Salin isi variabel di bawah ke Vercel -> Project Settings -> Environment Variables
# (Atau langsung Paste block ini di kolom "Import .env" Vercel)
# ==============================================================================

# 1. Database Neon PostgreSQL
# Otomatis terisi jika menambahkan "Neon" dari Vercel Marketplace / Storage.
# Jika manual dari dashboard Neon, isi keduanya dengan Connection String Neon Anda:
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# 2. Akun & Keamanan Panel Admin (/admin/login -> /admin)
# Dipakai saat seed pertama kali ke database & sebagai cadangan login saat DB offline.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-sandi-admin-yang-kuat"
ADMIN_SESSION_SECRET="ganti-dengan-minimal-32-karakter-acak-rahasia"

# 3. Domain & Kontak Resmi Website
NEXT_PUBLIC_SITE_URL="https://glamandglow.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"
NEXT_PUBLIC_INSTAGRAM_USERNAME="4saudarakukisuksesemua27"
NEXT_PUBLIC_EMAIL_CONTACT="4Saudarakukisuksesemua27@gmail.com"
